{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Backend (Spring Boot)",
      "type": "shell",
      "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/backend/start-backend.ps1\"",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Run Frontend (React Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Chạy Cả Hai (Backend + Frontend)",
      "dependsOn": [
        "Run Backend (Spring Boot)",
        "Run Frontend (React Vite)"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
